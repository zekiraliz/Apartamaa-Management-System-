* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f7fb;
  color: #172033;
}

.topbar {
  background: #102a43;
  color: white;
  padding: 24px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.topbar h1 {
  margin: 0;
}

.topbar p {
  margin: 6px 0 0;
}

.nav {
  background: white;
  padding: 14px 6%;
  display: flex;
  gap: 24px;
}

.nav a {
  text-decoration: none;
  color: #102a43;
  font-weight: bold;
}

.hero {
  margin: 30px 6%;
  padding: 45px;
  border-radius: 18px;
  background: linear-gradient(135deg, #102a43, #1f6f8b);
  color: white;
}

.hero h2 {
  font-size: 36px;
  max-width: 700px;
}

.hero p {
  max-width: 700px;
  line-height: 1.7;
}

.badge {
  background: #ffffff22;
  border: 1px solid #ffffff55;
  padding: 7px 12px;
  border-radius: 20px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin: 0 6% 35px;
}

.card {
  background: white;
  border-radius: 14px;
  padding: 20px;
  box-shadow: 0 5px 20px #0000000d;
}

.stat span {
  color: #65748b;
}

.stat strong {
  display: block;
  font-size: 32px;
  margin-top: 10px;
}

.section {
  margin: 35px 6%;
}

.section-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}

button {
  border: 0;
  background: #147d92;
  color: white;
  padding: 11px 17px;
  border-radius: 9px;
  font-weight: bold;
}

.table-wrap {
  overflow: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 720px;
}

th,
td {
  text-align: left;
  padding: 13px;
  border-bottom: 1px solid #e8edf3;
}

th {
  background: #f7f9fc;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.apt {
  border-left: 5px solid #16803c;
}

.allocated {
  border-left-color: #c77700;
}

.status {
  font-weight: bold;
}

.allocation-box {
  line-height: 1.7;
}

.message {
  margin-top: 15px;
  font-weight: bold;
}

footer {
  text-align: center;
  padding: 35px;
  color: #68778d;
}

@media (max-width: 800px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .hero h2 {
    font-size: 28px;
  }
}

@media (max-width: 500px) {
  .stats {
    grid-template-columns: 1fr;
  }
}
